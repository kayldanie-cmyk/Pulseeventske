# ==============================================================================
# PULSE EVENTS KE — ENVIRONMENT CONFIGURATION
# ==============================================================================
# Copy this file to .env.local:
#   cp .env.example .env.local

# ------------------------------------------------------------------------------
# 1. Base App URL
# ------------------------------------------------------------------------------
NEXT_PUBLIC_BASE_URL=https://pulseevents.co.ke

# ------------------------------------------------------------------------------
# 2. Supabase (PostgreSQL Database, Auth, Storage)
# https://supabase.com/dashboard/project/_/settings/api
# ------------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your-anon-key-here
# Server-only service role key with admin privileges (NEVER prefix with NEXT_PUBLIC_)
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key-here

# ------------------------------------------------------------------------------
# 3. Safaricom Daraja API (M-Pesa STK Push Express)
# https://developer.safaricom.co.ke/
# ------------------------------------------------------------------------------
MPESA_ENV=sandbox
MPESA_CONSUMER_KEY=your_daraja_consumer_key
MPESA_CONSUMER_SECRET=your_daraja_consumer_secret
# Default Daraja Sandbox Shortcode is 174379
MPESA_SHORTCODE=174379
MPESA_PASSKEY=bfb279f9aa9bdbcf158e97dd71a467cd2e0c893059b10f78e6b72ada1ed2c919
MPESA_CALLBACK_URL=https://your-domain.com/api/mpesa/callback

# ------------------------------------------------------------------------------
# 4. Ticket Cryptographic Signing (HMAC-SHA256)
# ------------------------------------------------------------------------------
# 32+ character random secret used to generate & verify tamper-proof ticket QR passes
TICKET_SIGNING_SECRET=pulse_events_secret_key_change_in_production_32chars

# ------------------------------------------------------------------------------
# 5. Africa's Talking (SMS Notifications)
# https://africastalking.com/
# ------------------------------------------------------------------------------
AFRICASTALKING_API_KEY=
AFRICASTALKING_USERNAME=sandbox
AFRICASTALKING_SENDER_ID=PULSE

# ------------------------------------------------------------------------------
# 6. Automated Order Expiry Cron (Vercel Cron)
# ------------------------------------------------------------------------------
# Secret token to protect /api/orders/expire from unauthorized calls
CRON_SECRET=generate_a_random_cron_secret_token_here
