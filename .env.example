# ------------------------------------------------------------------------------
# 1. Supabase (Database, Auth, Storage)
# https://supabase.com/dashboard/project/_/settings/api
# ------------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your-anon-key-here
# Server-only service role key (NEVER prefix with NEXT_PUBLIC_)
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your-service-role-key-here

# ------------------------------------------------------------------------------
# 2. Safaricom Daraja M-Pesa (M-Pesa STK Push)
# https://developer.safaricom.co.ke/
# ------------------------------------------------------------------------------
MPESA_ENV=sandbox
MPESA_CONSUMER_KEY=
MPESA_CONSUMER_SECRET=
MPESA_SHORTCODE=174379
MPESA_PASSKEY=
MPESA_CALLBACK_URL=https://your-domain.com/api/mpesa/callback

# ------------------------------------------------------------------------------
# 3. Messaging & Ticket Security
# ------------------------------------------------------------------------------
# Generate a random 32-character string for signing ticket QR codes:
TICKET_SIGNING_SECRET=pulse_events_secret_key_change_in_production_32chars

# Africa's Talking (SMS notifications)
AT_API_KEY=
AT_USERNAME=sandbox

# WhatsApp Business API
